# Copy to .env in the repository root before running Docker Compose.
POSTGRES_PASSWORD=choose-a-strong-database-password
APP_SECRET=choose-a-long-random-secret

# Optional: leave blank to disable Google OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000

# Optional until photo uploads are used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For local Docker, the default is correct. For hosted deployments, set before building.
REACT_APP_API_URL=http://localhost:8000
